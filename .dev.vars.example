STRIPE_API_KEY=sk_test_...

# From your Google Cloud OAuth client (Web application type)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# creates/applies the "processed" label on threads.
# Exact Gmail label to filter on, e.g. "billpay"
GMAIL_LABEL=...

# Anthropic API key used to run the skill (drives Gmail + Stripe tool calls)
ANTHROPIC_API_KEY=sk-ant-...

# Basic auth credentials required to POST /run and trigger the agent.
# In production, set these with `wrangler secret put RUN_AUTH_USERNAME` /
# `wrangler secret put RUN_AUTH_PASSWORD` rather than plaintext vars.
RUN_AUTH_USERNAME=...
RUN_AUTH_PASSWORD=...

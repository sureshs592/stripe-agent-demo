STRIPE_API_KEY=sk_test_...

# From your Google Cloud OAuth client (Web application type)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Minted once via the OAuth 2.0 Playground (or an equivalent auth-code exchange),
# using the gmail.readonly scope for the target inbox
GOOGLE_REFRESH_TOKEN=1//...
# Exact Gmail label to filter on, e.g. "billpay"
GMAIL_LABEL=...

# Anthropic API key used to run the skill (drives Gmail + Stripe tool calls)
ANTHROPIC_API_KEY=sk-ant-...
